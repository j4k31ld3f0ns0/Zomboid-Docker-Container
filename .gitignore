# Secrets. .env holds ADMIN_PASSWORD / CFG_PASSWORD / RCON_PASSWORD.
.env
*.env
!*.env.example

# Game install: ~7GB, restored by SteamCMD on first boot.
Build42/server_files/

# Worlds, configs, backups and the recorded build id.
Build42/zomboid_data/
Build42/zomboid_data_test/

# Watcher state: recreated from the Steam API on first run.
Build42/mod_watcher_state/*.json

# Python
__pycache__/
*.pyc
