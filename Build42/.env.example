# Copy to .env and set real values. .env is gitignored; this file is not.
ADMIN_PASSWORD=changeme
# The password players type to join. Deliberately NOT named CFG_PASSWORD:
# start.sh writes every CFG_-prefixed variable into <SERVER_NAME>.ini with the
# prefix stripped, so that name would add a junk "PASSWORD=" key. The real key
# is set by CFG_Password in docker-compose.yml, which reads this.
SERVER_PASSWORD=changeme
RCON_PASSWORD=changeme
