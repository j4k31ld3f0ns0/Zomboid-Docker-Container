# Use a newer Debian base (Bookworm/12) for updated C++ libraries required by newer PZ builds
FROM debian:bookworm-slim

# Avoid prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# 1. Enable non-free repositories & install dependencies
# Debian 12 uses deb822 format, so we update debian.sources
RUN sed -i 's/Components: main/Components: main contrib non-free non-free-firmware/g' /etc/apt/sources.list.d/debian.sources && \
    dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y \
    lib32gcc-s1 \
    lib32stdc++6 \
    curl \
    wget \
    ca-certificates \
    locales \
    git \
    netcat-traditional \
    procps \
    jq \
    nano \
    python3-minimal \
    && rm -rf /var/lib/apt/lists/*

# 2. Configure Locale
RUN sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen && \
    dpkg-reconfigure --frontend=noninteractive locales && \
    update-locale LANG=en_US.UTF-8

ENV LANG=en_US.UTF-8

# 3. Create a non-root user 'pzuser'
RUN useradd -m -d /home/pzuser -s /bin/bash pzuser

# 4. Install SteamCMD the official way
RUN apt-get update && \
    echo steam steam/question select "I AGREE" | debconf-set-selections && \
    echo steam steam/license note '' | debconf-set-selections && \
    apt-get install -y steamcmd && \
    rm -rf /var/lib/apt/lists/*

# Create symlinks to ensure paths are always correct
RUN ln -sf /usr/games/steamcmd /usr/bin/steamcmd

# 4b. Install rcon-cli, used by the health check to query the player list
ARG RCON_VERSION=0.10.3
ARG RCON_SHA256=6962a641ebf9a5957bd0cda1b8acf3e34a23686ae709f6c6a14ac3898521a5cc
RUN curl -fsSL -o /tmp/rcon.tar.gz \
      "https://github.com/gorcon/rcon-cli/releases/download/v${RCON_VERSION}/rcon-${RCON_VERSION}-amd64_linux.tar.gz" && \
    echo "${RCON_SHA256}  /tmp/rcon.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/rcon.tar.gz -C /tmp && \
    install -m 0755 "/tmp/rcon-${RCON_VERSION}-amd64_linux/rcon" /usr/local/bin/rcon && \
    rm -rf /tmp/rcon.tar.gz "/tmp/rcon-${RCON_VERSION}-amd64_linux"

# 5. Setup directories and permissions
USER pzuser
WORKDIR /home/pzuser

# Create standard directories for volume mounting
RUN mkdir -p /home/pzuser/server /home/pzuser/Zomboid

# 6. Copy the entrypoint, health-check and sandbox-converter scripts
COPY --chown=pzuser:pzuser start.sh healthcheck.sh pzConfigConverter.py /home/pzuser/

# Remove Windows line endings (CRLF) to prevent 'command not found' errors
RUN sed -i 's/\r$//' /home/pzuser/start.sh /home/pzuser/healthcheck.sh /home/pzuser/pzConfigConverter.py

RUN chmod +x /home/pzuser/start.sh /home/pzuser/healthcheck.sh /home/pzuser/pzConfigConverter.py

# 7. Expose Ports
EXPOSE 16261/udp 16262/udp 8766/udp 27015/tcp

# 8. HEALTHCHECK
# Baseline only. docker-compose.yml overrides this with a much longer
# start_period plus start_interval, which is what actually fixes the
# "unhealthy during first boot" problem.
HEALTHCHECK --interval=30s --timeout=20s --start-period=45m --retries=3 \
  CMD ["/home/pzuser/healthcheck.sh"]

STOPSIGNAL SIGTERM

# 9. Start the container
ENTRYPOINT ["/home/pzuser/start.sh"]